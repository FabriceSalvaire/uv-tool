class UvCacheDirectory(UvCacheMixin):

    ##############################################

    def __init__(self, path: Path) -> None:
        super().__init__(path)
        C.print(f"{self.path.name:16} {human_size(self.size):>10}")

        size_accumulator = 0
        name = self.path.name
        if name.startswith('archive'):
            # archive-v0/uuid/
            #   package/
            #   package-version.data/
            #   package-version.dist-info/
            packages = [Package(_) for _ in self.path.iterdir() if _.is_dir()]
            # for _ in sorted(packages, key=lambda _: _.name):
            for _ in sorted(packages, key=lambda _: _.size):
                size_accumulator += _.size
                C.print(f"    {_.name:30} {_.version:16} {human_size(_.size):>10}   [yellow]{human_size(size_accumulator):>10}")
        elif name.startswith('sdist'):
            path = self.path / 'pypi'
            with C.status(f"Computing {path} size..."):
                # Fixme: bucket: editable git path
                for _ in sorted(path.iterdir()):
                    # /package_name/version/uuid/
                    #   package-version-cp315-cp315-linux_x86_64 symlink to archive-v0/uuid
                    #   package-version-cp315-cp315-linux_x86_64.whl
                    #   src
                    size = disk_size(_)
                    size_accumulator += size
                    C.print(f"    {_.name:30} {human_size(size):>10}   [yellow]{human_size(size_accumulator):>10}")

        # if size_accumulator:
