def cache_size_command() -> None:
    with C.status(f"Computing {CACHE_DIR} size..."):
        size = disk_size(CACHE_DIR)
    C.print(f"UV Cache is: {CACHE_DIR}   {human_size(size)}")
    for _ in sorted(CACHE_DIR.iterdir()):
        if _.is_dir() and _.name[0] != '.':
            look_cache(_)

    C.print()
    C.print('Packages with several versions:')
    C.print('  (duplicates corresponds to different cpython)')
    C.print()
    for name in sorted(Package.VERSION_MAP):
        versions = sorted(Package.VERSION_MAP[name])
        if len(versions) > 1:
            C.print(f"  {name:32} {versions}")

