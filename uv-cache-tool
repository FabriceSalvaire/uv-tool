def look_cache(cache_path: Path) -> None:
    with C.status(f"Computing {cache_path} size..."):
        size = disk_size(cache_path)
    C.print(f"{cache_path.name:16} {human_size(size):>10}")
    size_accumulator = 0

    name = cache_path.name
    if name.startswith('sdist'):
        path = cache_path / 'pypi'
        for _ in sorted(path.iterdir()):
            size = disk_size(_)
            size_accumulator += size
            C.print(f"    {_.name:30} {human_size(size):>10}   [yellow]{human_size(size_accumulator):>10}")
    if name.startswith('archive'):
        packages = [Package(_) for _ in cache_path.iterdir() if _.is_dir()]
        # for _ in sorted(packages, key=lambda _: _.name):
        for _ in sorted(packages, key=lambda _: _.size):
            size_accumulator += _.size
            C.print(f"    {_.name:30} {_.version:16} {human_size(_.size):>10}   [yellow]{human_size(size_accumulator):>10}")
    # if size_accumulator:
    #     C.print(f"  [yellow]Size accumulator: {human_size(size_accumulator)}")

