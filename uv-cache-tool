class UvCacheMixin:

    ##############################################

    def __init__(self, path: Path) -> None:
        # print(f"Path {path}")
        self.path = path
        self._size: int | None = None  # lazy

    ##############################################

    @property
    def size(self) -> int:
        if self._size is None:
            with C.status(f"Computing {self.path} size..."):
                self._size = disk_size(self.path)
        return self._size

####################################################################################################

class UvCache(UvCacheMixin):

    ##############################################

    def __init__(self, path: Path) -> None:
        super().__init__(path)
        self.packages: dict[str, Package] = {}
        self._scan_archive()
        self.sdist_packages: dict[str, Package] = {}
        self._scan_sdist()

    ##############################################

    def list(self) -> None:
        def print_directory(directory: dict[str, Package]) -> None:
            for package in sorted(directory.values(), key=lambda _: _.name):
                C.print(f"[blue]{package.name}")
                for version in package:
                    path = str(version.path.relative_to(CACHE_DIR))
                    nlink = version.nlink if isinstance(version, ArchivePackage) else '---'
                    C.print(f"  v{version.version:<24} @{version.py_version}   {path:<30}  #{nlink}")

        C.rule()
        C.print("[red]SDist Packages")
        print_directory(self.sdist_packages)
        C.rule()
        C.print("[red]Packages")
        print_directory(self.packages)

    ##############################################

    def compute_size(self, min_size: int = 0) -> None:
        C.print(f"UV Cache is: {CACHE_DIR}   {human_size(self.size)}")
        self.directories: dict[str, UvCacheDirectory] = {}
        for subdir_path in sorted(self.path.iterdir()):
            if subdir_path.is_dir() and subdir_path.name[0] != '.':
                directory = UvCacheDirectory(subdir_path)
                self.directories[directory.name] = directory
                C.print(f"  {directory.path.name:16} {human_size(directory.size):>10}")

        def sort_key_by_name(_: Package) -> str:
            return _.name

        def sort_key_by_size(_: Package) -> int:
            return _.size

        def print_directory(directory: dict[str, Package]) -> None:
            sort_key = sort_key_by_size
            packages = sorted(directory.values(), key=sort_key)
            for package in packages:
                size = package.size
                if size < min_size:
                    continue
                C.print(f"[blue]{package.name:<28} {human_size(size):>10}")
                for package_version in cast(Iterator[SdistPackage], package):
                    version = package_version.version
                    py_version = str(package_version.py_version)
                    size = package_version.size
                    path = package_version.path.relative_to(CACHE_DIR)
                    C.print(f"  v{version:<12} @{py_version:<8} {human_size(size):>13}   {path}")

        C.rule()
        C.print("[red]SDist Packages")
        print_directory('sdist-v9', self.sdist_packages)
        C.rule()
        C.print("[red]Packages")
        print_directory(self.packages)

    ##############################################

    def _scan_archive(self) -> None:
        path = self.path / 'archive-v0'
        packages = [ArchivePackage(_) for _ in path.iterdir() if _.is_dir()]
        for package in packages:
            self.packages.setdefault(package.name, Package(package.name)).add_version(package)

    ##############################################

    def _scan_sdist(self) -> None:
        path = self.path / 'sdists-v9'
        # Fixme: bucket: editable git path
        packages = [
            SdistPackage(version)
            for package in (path / 'pypi').iterdir()
            for version in package.iterdir()
        ]
        # Fixme: duplicated code
        for package in packages:
            self.sdist_packages.setdefault(package.name, Package(package.name)).add_version(package)

